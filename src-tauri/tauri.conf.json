{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Himeno Text Editor",
  "version": "0.8.0",
  "identifier": "com.EtihwRuoNiao.HimenoTextEditor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Himeno Text Editor 0.8.0",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
